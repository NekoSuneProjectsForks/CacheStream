# Force LF line endings inside the repo regardless of the contributor's
# OS. Critical for shell scripts (entrypoint.sh) — CRLF makes them
# fail with "exec format error" inside Linux containers.
* text=auto eol=lf
*.sh    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf

# Binaries — never touch.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.webp  binary
*.gif   binary
*.ico   binary
*.mp3   binary
*.mp4   binary
