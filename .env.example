# =========================================================
# CacheStream — Next.js Control Panel + Headless Streamer
# =========================================================
# Copy to `.env`. Used by both docker-compose AND the two
# Node processes (web + streamer) at runtime.
# =========================================================


# =============================================
# 1. Public surface (web container)
# =============================================
# Internal port the Next.js server binds. Cloudflare Tunnel
# (configured in the Cloudflare dashboard) points at
# http://<host>:7788.
WEB_PORT=7788

# Public-facing URL of the control panel. MUST match the
# hostname you set in the Cloudflare Tunnel public-hostname
# UI, AND the OAuth Redirect URL you register in the Twitch
# developer console (minus the /api/auth/twitch/callback
# suffix).
#
# Example:
#   https://stream.example.com
PUBLIC_URL=https://stream.example.com

# Trust X-Forwarded-* headers from the reverse proxy
# (Cloudflare Tunnel). Required for Secure cookies + correct
# client-IP logging.
TRUST_PROXY=true


# =============================================
# 2. Twitch OAuth (admin login)
# =============================================
# Register an app at https://dev.twitch.tv/console/apps
#   OAuth Redirect URL:  <PUBLIC_URL>/api/auth/twitch/callback
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Long random string for session cookie + state HMAC.
# Generate with: openssl rand -hex 48
SESSION_SECRET=

# Optional: pre-claim ownership for this Twitch login so the
# first-login-wins step is skipped. Lowercase login name only.
INITIAL_OWNER_LOGIN=


# =============================================
# 3. Web ↔ Streamer (internal RPC)
# =============================================
# Internal hostname/port. Inside docker-compose the streamer
# is reachable at http://streamer:7789. From your host (dev),
# use http://localhost:7789.
STREAMER_URL=http://streamer:7789

# Shared bearer token between web and streamer. Generate with:
# openssl rand -hex 32. The streamer rejects requests that
# don't present this token.
INTERNAL_API_TOKEN=


# =============================================
# 4. Twitch streaming destination (RTMP)
# =============================================
# Your channel stream key — get it at:
#   https://dashboard.twitch.tv/settings/stream
TWITCH_STREAM_KEY=

# Ingest endpoint. Default works globally; pick a regional
# server from https://help.twitch.tv/s/twitch-ingest-recommendation
TWITCH_INGEST_URL=rtmp://live.twitch.tv/app


# =============================================
# 5. Stream encoding
# =============================================
# With STREAM_PROFILE=auto (v1.6 default) these can stay BLANK
# and the streamer will pick sensible defaults per host:
#   - Raspberry Pi    → 720p30, h264_v4l2m2m (HW), ~2800 kbps
#   - Weak ARM box    → 720p30, libx264 ultrafast, ~3000 kbps
#   - 1-2 core x86    → 720p30, libx264 veryfast, ~3500 kbps
#   - 4-8 core x86    → 1080p30, libx264 veryfast, 4500 kbps
#   - 12+ core x86    → 1080p60, libx264 medium, 6000 kbps
# Set anything explicitly to override.
STREAM_WIDTH=
STREAM_HEIGHT=
STREAM_FPS=

# Video bitrate (kbps). Twitch sweet spot for 1080p30 is
# 4500–6000. Leave blank to let auto-profile pick.
STREAM_VIDEO_BITRATE=
STREAM_VIDEO_MAXRATE=
STREAM_VIDEO_BUFSIZE=

STREAM_AUDIO_BITRATE=

# ---- Auto-adaptive profile (v1.6) ------------------------
# `auto` detects host (CPU cores, arch, RAM, Pi vs x86) and
# auto-tunes resolution/bitrate/preset/threads/codec. Any
# explicit STREAM_* var below still wins.
#
# Set to `manual` to skip auto-detect and use the values below.
STREAM_PROFILE=auto

# Live thermal monitor. When the CPU crosses
# STREAM_THERMAL_THROTTLE_C, the streamer hot-restarts FFmpeg
# with a thermal-safe profile (720p / low bitrate / ultrafast).
# Recovers when temp drops below STREAM_THERMAL_RECOVER_C.
# Auto-disabled on hosts without /sys/class/thermal/thermal_zone0.
STREAM_THERMAL_MONITOR=true
STREAM_THERMAL_THROTTLE_C=80
STREAM_THERMAL_RECOVER_C=68

# Force a specific video codec. Default auto-detects:
# h264_v4l2m2m on a Pi, h264_nvenc on NVIDIA, libx264 otherwise.
# STREAM_VIDEO_CODEC=libx264

# ---- Manual encoder knobs --------------------------------
# Leave these BLANK to let auto-profile pick. Set to override.

# x264 preset: ultrafast | superfast | veryfast | faster | fast | medium
STREAM_PRESET=

# x264 worker threads. 0 = auto (= num CPU cores). Pin to 2 or
# 3 on small VPSes if other processes share the box.
STREAM_X264_THREADS=

# x264 tune. `zerolatency` disables lookahead — handy for
# interactive use, but a small quality hit for one-way RTMP.
# Try empty (no tune) or `fastdecode` on weak hardware.
STREAM_X264_TUNE=

# Chromium CDP screencast JPEG quality (1–100). 70 is the
# sweet spot — visually identical post H.264, less CPU spent
# on JPEG encode (Chromium) and decode (FFmpeg).
STREAM_SCREENCAST_QUALITY=

# Capture every Nth frame. 1 = every frame. Set to 2 if your
# scene paints at 60fps but you only need 30 — halves the
# JPEG decode load on FFmpeg.
STREAM_CAPTURE_EVERY_NTH=


# =============================================
# 6. Scenes
# =============================================
# Default scene Puppeteer loads on startup. The control panel
# can change this at runtime; this is just the boot default.
# Inside docker-compose the web container is `web`:
DEFAULT_SCENE_URL=http://web:7788/scene


# =============================================
# 7. Music (v1.2)
# =============================================
# Path inside the web container where local music files live.
# docker-compose mounts ./media/music here from the host. Drop
# MP3/OGG/FLAC files into ./media/music on the host and they
# show up in the panel's Music tab.
MUSIC_LIBRARY_DIR=/app/media/music


# =============================================
# 8. Runtime
# =============================================
LOG_LEVEL=info
RECONNECT_DELAY_SECONDS=5

# Auto-start the stream when the streamer container boots?
# Usually false — use the control panel to start.
AUTO_START_STREAM=false
