# ── OAuth2 relay configuration ───────────────────────────────────────────
# Copy to .env (gitignored) and fill in. The client SECRETS only ever live
# here, server-side.

# Where the server listens.
PORT=8788
BIND_HOST=0.0.0.0

# PUBLIC mode: the domain the provider redirects back to. MUST match the
# redirect URI base you registered on each provider app. Default public
# instance: https://nekostreamappoauth2.nekosunevr.co.uk
# Then register each provider's callback as:
#   https://nekostreamappoauth2.nekosunevr.co.uk/oauth/twitch/callback   (etc.)
# Leave empty for LOCAL/dev (derived from the request Host header).
PUBLIC_URL=https://nekostreamappoauth2.nekosunevr.co.uk

# Behind a TLS-terminating proxy (nginx/Caddy/Cloudflare)? keep true.
TRUST_PROXY=true

# Only loopback app redirect_uris are accepted by default (the secure native
# pattern). To also allow a trusted web origin (e.g. a Docker panel), list it:
# ALLOWED_APP_ORIGINS=https://panel.example.com
ALLOW_NON_LOOPBACK_APP_REDIRECT=false

# ── Providers — "bring your own keys" (a provider with no CLIENT_ID is off) ─
# Twitch  (https://dev.twitch.tv/console/apps) — redirect: <PUBLIC_URL>/oauth/twitch/callback
RELAY_TWITCH_CLIENT_ID=
RELAY_TWITCH_CLIENT_SECRET=
# RELAY_TWITCH_SCOPE=user:read:email chat:read chat:edit

# Kick  (https://kick.com/developer) — redirect: <PUBLIC_URL>/oauth/kick/callback  (PKCE)
RELAY_KICK_CLIENT_ID=
RELAY_KICK_CLIENT_SECRET=
# RELAY_KICK_SCOPE=user:read channel:read chat:write events:subscribe

# YouTube / Google  (https://console.cloud.google.com) — redirect: <PUBLIC_URL>/oauth/youtube/callback
RELAY_YOUTUBE_CLIENT_ID=
RELAY_YOUTUBE_CLIENT_SECRET=
# RELAY_YOUTUBE_SCOPE=https://www.googleapis.com/auth/youtube.readonly

# Tuning (optional)
# TX_TTL_MS=600000
# PICKUP_TTL_MS=120000
# RATE_MAX_PER_MIN=60
# LOG_LEVEL=info
